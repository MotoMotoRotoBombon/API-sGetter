{
  "name": "citypulse",
  "version": "1.0.0",
  "description": "CityPulse — learning AWS Serverless, API Gateway, DynamoDB, SNS/SQS, and CI/CD",
  "main": "dist/handlers.js",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "offline": "serverless offline --stage dev",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "keywords": [
    "aws",
    "serverless",
    "api-gateway",
    "dynamodb",
    "sns",
    "sqs"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "serverless"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "serverless": "^4.37.0",
    "serverless-offline": "^14.7.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.712.0",
    "@aws-sdk/client-sns": "^3.1051.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  }
}
